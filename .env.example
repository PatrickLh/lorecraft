# ---- 服务 ----
PORT=8787
HOST=127.0.0.1
SQLITE_PATH=./data/lorecraft.db

# ---- LLM ----
# mock | deepseek | claude
LLM_PROVIDER=mock

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Claude（Anthropic Messages API）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# 每日完整剧本调用超时（毫秒），独立于单轮叙事
LLM_DAILY_TIMEOUT_MS=120000
# 单次 LLM 调用超时（毫秒）
LLM_TIMEOUT_MS=60000
# 记忆提炼 / 滚动摘要调用超时（毫秒）
LLM_AUX_TIMEOUT_MS=30000
